FROM python:3.10-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ui/ /app/src/ui/

# FIX: Wildcard bracket notation prevents build failure if weights are absent in CI
COPY final_pinn_model.pt[h] /app/

# FIX: Pre-create datasets folder and safely copy contents if they exist
RUN mkdir -p /app/datasets
COPY datasets/ /app/datasets/

EXPOSE 8501

CMD ["streamlit", "run", "src/ui/comparison.py", "--server.address=0.0.0.0"]
